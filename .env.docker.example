# ==========================================
# KalTech E-Commerce - Docker Compose Environment
# Copia este archivo como .env en la raíz del repositorio:
#   cp .env.docker.example .env
# ==========================================

# Puertos expuestos en el host
CLIENT_PORT=80
SERVER_PORT=5000
MONGO_PORT=27017

# Base de datos (Dentro de la red Docker usa 'mongo', en Atlas usa la URI de MongoDB Atlas)
MONGO_URI=mongodb://mongo:27017/kaltech

# URLs del cliente permitidas por CORS
CLIENT_URL=http://localhost,http://127.0.0.1,http://localhost:80

# Autenticación JWT (Obligatorio en producción: generar clave aleatoria de al menos 32 caracteres)
JWT_SECRET=tu_clave_secreta_jwt_de_produccion_con_al_menos_32_caracteres
JWT_EXPIRES_IN=7d

# Cuenta de Administrador inicial (seeding)
ADMIN_NAME=Administrador KalTech
ADMIN_EMAIL=admin@kaltech.com
ADMIN_PASSWORD=Admin1234!

# Almacenamiento multimedia Cloudinary (Imágenes de productos y categorías)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Servicio de Correo SMTP (Notificaciones de órdenes y bienvenida)
# Dejar vacío para usar sandbox de consola local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=KalTech <notificaciones@kaltech.com>

# Pasarelas de Pago (Stripe & PayPal)
# Dejar vacías para usar el simulador de pagos sandbox integrado
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=

# Autenticación Social (Google & Facebook)
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
