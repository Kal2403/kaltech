PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

MONGO_URI=mongodb://localhost:27017/kaltech

JWT_SECRET=your_jwt_secret_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Initial Admin Seeding (npm run seed:admin)
ADMIN_NAME=Administrador KalTech
ADMIN_EMAIL=admin@kaltech.com
ADMIN_PASSWORD=Admin1234!

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SMTP Email Service (e.g. Resend, SendGrid, Brevo, SES)
# Leave empty for zero-config local console sandbox:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=KalTech <notificaciones@kaltech.com>
