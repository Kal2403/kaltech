# KalTech E-Commerce - Client Environment Variables

# URL base del backend Express (incluyendo el prefijo /api)
# Local: http://localhost:5000/api
# Producción: https://api.tudominio.com/api o https://tudominio.com/api
VITE_API_URL=http://localhost:5000/api

# Pasarelas de Pago Frontend (Opcionales si se configuran directamente en cliente)
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_PAYPAL_CLIENT_ID=
